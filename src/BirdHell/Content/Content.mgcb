/processor:SoundEffectProcessor
/build:audio/oof.wav

#begin audio/hit.wav
/importer:WavImporter
/processor:SoundEffectProcessor
/build:audio/hit.wav

#begin audio/death_sound.wav
/importer:WavImporter
/processor:SoundEffectProcessor
/build:audio/death_sound.wav

#begin audio/enemy_death.wav
/importer:WavImporter
/processor:SoundEffectProcessor
/build:audio/enemy_death.wav

#begin audio/blaster.wav
